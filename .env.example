# Copia este archivo como .env y completa los valores.
# El .env NUNCA se sube a git (ya esta en .gitignore).
# Detalle de cada variable: docs/DOCUMENTACION_TECNICA.md

# --- Django ---
# Genera una con: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=
# URL publica del sitio (se usa en los enlaces de los correos). En local: http://127.0.0.1:8000
PUBLIC_SITE_URL=http://127.0.0.1:8000
# Correos con permiso de administrador del laboratorio, separados por coma.
# Pueden eliminar proyectos y reciben las solicitudes de registro de usuarios externos.
LAB_ADMIN_EMAILS=correo_admin@dominio.cl

# --- PostgreSQL ---
POSTGRES_DB=seguimiento_proyectos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Correo (Brevo SMTP) ---
# Mientras no tengas Brevo, deja la consola: los correos se imprimen en la terminal.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Para enviar de verdad con Brevo, cambia a:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Login SMTP que muestra Brevo (no es tu correo personal) y la clave SMTP generada en Brevo
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Remitente: debe ser un correo verificado como "sender" en Brevo
DEFAULT_FROM_EMAIL=Plataforma de Proyectos <correo_verificado@dominio.cl>
EMAIL_TIMEOUT=10

# --- Inteligencia artificial ---
# Gemini es el proveedor principal; Groq es el respaldo si Gemini falla.
# Con al menos una de las dos claves la IA funciona. Sin ninguna, la app funciona igual pero sin IA.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
AI_TIMEOUT_SECONDS=25
